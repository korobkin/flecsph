#initial data
  initial_data_prefix = "hdf5_bns_3D_25424"
  initial_iteration = 0

# equation of state
  eos_type = "polytropic"
  poly_gamma = 1.4

# sph kernel
  sph_kernel = "Wendland C6"
  sph_eta = 1.6
  sph_variable_h = no

# evolution parameters
  initial_dt = 0.001
  timestep_cfl_factor = 0.01
  adaptive_timestep = no
  final_iteration = 100000
  thermokinetic_formulation = FALSE

# output
  out_screen_every = 10
  out_scalar_every = 10
  out_h5data_every = 500
  output_h5data_prefix = "bns_test_out"

# gravity related parameters:
  enable_fmm = yes
  fmm_macangle = 0.0
  gravitational_constant = 6.674e-8
  # Enable GW radiation reaction for binary inspiral
  enable_gw_rad = false 
